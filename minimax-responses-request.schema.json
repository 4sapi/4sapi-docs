{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.minimaxi.com/schemas/responses-request.json",
  "title": "MiniMax Responses API Request",
  "description": "POST /v1/responses 请求体 JSON Schema。",
  "type": "object",
  "required": [
    "model",
    "input"
  ],
  "properties": {
    "model": {
      "type": "string",
      "description": "调用的模型名称，例如 MiniMax-M3。"
    },
    "service_tier": {
      "type": "string",
      "description": "请求准入服务层级。省略时默认使用 standard。",
      "enum": [
        "standard",
        "priority"
      ],
      "default": "standard"
    },
    "input": {
      "description": "对话内容，支持简单文本或完整对话历史数组。",
      "oneOf": [
        {
          "type": "string",
          "description": "简单文本输入。"
        },
        {
          "type": "array",
          "description": "完整对话历史。",
          "items": {
            "$ref": "#/$defs/input-item"
          }
        }
      ]
    },
    "instructions": {
      "type": "string",
      "description": "系统指令。"
    },
    "max_output_tokens": {
      "type": "integer",
      "description": "最大输出 token 数。"
    },
    "temperature": {
      "type": "number",
      "format": "float",
      "description": "采样温度，取值范围 (0, 1]。",
      "minimum": 0,
      "maximum": 1,
      "default": 1
    },
    "top_p": {
      "type": "number",
      "format": "float",
      "description": "核采样，取值范围 (0, 1]。",
      "minimum": 0,
      "maximum": 1,
      "default": 0.95
    },
    "stream": {
      "type": "boolean",
      "description": "设置为 true 启用 SSE 流式响应。",
      "default": false
    },
    "tools": {
      "type": "array",
      "description": "工具列表。",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "tool_choice": {
      "type": "string",
      "enum": [
        "none",
        "auto"
      ],
      "description": "工具选择策略：none 表示不调用工具，auto 表示由模型自动判断。"
    },
    "metadata": {
      "type": "object",
      "description": "请求元数据，key 和 value 均为字符串。",
      "additionalProperties": {
        "type": "string"
      }
    },
    "prompt_cache_key": {
      "type": "string",
      "description": "Prompt 缓存路由标识。"
    },
    "text": {
      "$ref": "#/$defs/text-output-config"
    },
    "reasoning": {
      "$ref": "#/$defs/reasoning"
    }
  },
  "$defs": {
    "input-item": {
      "type": "object",
      "description": "对话历史条目。type 缺省时按 message 处理。",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "message",
            "function_call",
            "function_call_output",
            "reasoning"
          ],
          "default": "message",
          "description": "条目类型。"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant",
            "system",
            "developer",
            "tool"
          ],
          "description": "消息角色，仅当 type 为 message 时使用。"
        },
        "content": {
          "description": "消息内容，可以是字符串或多模态片段数组。",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/content-part"
              }
            }
          ]
        },
        "call_id": {
          "type": "string",
          "description": "工具调用 ID，用于关联 function_call 或 function_call_output。"
        },
        "name": {
          "type": "string",
          "description": "函数名，仅当 type 为 function_call 时使用。"
        },
        "arguments": {
          "type": "string",
          "description": "函数参数的 JSON 字符串，仅当 type 为 function_call 时使用。"
        },
        "output": {
          "description": "工具返回结果，仅当 type 为 function_call_output 时使用。",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/content-part"
              }
            }
          ]
        },
        "summary": {
          "type": "array",
          "description": "思维链段落数组，仅当 type 为 reasoning 时使用。",
          "items": {
            "$ref": "#/$defs/summary-part"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "function_call"
              }
            }
          },
          "then": {
            "required": [
              "call_id",
              "name",
              "arguments"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "function_call_output"
              }
            }
          },
          "then": {
            "required": [
              "call_id",
              "output"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "reasoning"
              }
            }
          },
          "then": {
            "required": [
              "summary"
            ]
          }
        }
      ]
    },
    "tool": {
      "type": "object",
      "description": "函数工具定义。",
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "function",
          "description": "工具类型，固定为 function。"
        },
        "name": {
          "type": "string",
          "description": "函数名称。"
        },
        "description": {
          "type": "string",
          "description": "函数说明，用于模型判断何时调用。"
        },
        "parameters": {
          "type": "object",
          "description": "函数参数定义，使用 JSON Schema 格式。"
        }
      }
    },
    "text-output-config": {
      "type": "object",
      "description": "输出格式控制。",
      "properties": {
        "format": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text",
              "default": "text",
              "description": "输出格式类型。"
            }
          }
        }
      }
    },
    "reasoning": {
      "type": "object",
      "description": "推理控制。MiniMax-M3 默认关闭推理；M2.x 模型无法关闭推理。",
      "properties": {
        "effort": {
          "type": "string",
          "enum": [
            "minimal",
            "low",
            "medium",
            "high",
            "none"
          ],
          "default": "none"
        }
      }
    },
    "summary-part": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "summary_text"
        },
        "text": {
          "type": "string",
          "description": "思维链文本。"
        }
      }
    },
    "content-part": {
      "description": "消息内容片段。",
      "oneOf": [
        {
          "$ref": "#/$defs/text-content-part"
        },
        {
          "$ref": "#/$defs/image-content-part"
        },
        {
          "$ref": "#/$defs/video-content-part"
        }
      ]
    },
    "text-content-part": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "input_text",
            "output_text"
          ]
        },
        "text": {
          "type": "string",
          "description": "文本内容。"
        }
      },
      "additionalProperties": false
    },
    "image-content-part": {
      "type": "object",
      "required": [
        "type",
        "image_url"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "input_image"
        },
        "image_url": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/image-url-object"
            }
          ],
          "description": "图片链接或 Base64 编码。"
        }
      },
      "additionalProperties": false
    },
    "video-content-part": {
      "type": "object",
      "required": [
        "type",
        "video_url"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "input_video"
        },
        "video_url": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/video-url-object"
            }
          ],
          "description": "视频链接或 Base64 编码。"
        }
      },
      "additionalProperties": false
    },
    "image-url-object": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "图片链接或 Base64 编码。"
        },
        "detail": {
          "type": "string",
          "enum": [
            "low",
            "default",
            "high"
          ],
          "default": "default",
          "description": "图片理解的精细度档位。"
        }
      }
    },
    "video-url-object": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "视频链接或 Base64 编码，大文件建议使用 File API 上传。"
        },
        "fps": {
          "type": "number",
          "format": "float",
          "default": 1,
          "minimum": 0.2,
          "maximum": 5,
          "description": "抽帧频率。"
        },
        "detail": {
          "type": "string",
          "enum": [
            "low",
            "default",
            "high"
          ],
          "default": "default",
          "description": "视频理解的精细度档位。"
        },
        "max_long_side_pixel": {
          "type": "integer",
          "minimum": 1,
          "description": "视频帧最长边的像素约束。"
        }
      }
    }
  }
}
